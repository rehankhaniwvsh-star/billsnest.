{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile document storing identity and subscription details",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user identifier",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Primary email address of the account user",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "Full name or display title of the user",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL or DiceBear avatar uri",
          "maxLength": 1000
        },
        "companyName": {
          "type": "string",
          "description": "Company, studio, or freelancing agency name",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Profession or business role of the user",
          "maxLength": 80
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether the new user has completed initial Google sign-up registration"
        },
        "plan": {
          "type": "string",
          "description": "Active Invobill subscription tier",
          "enum": ["free", "pro", "business"]
        },
        "billingCycle": {
          "type": "string",
          "description": "Subscription billing cadence",
          "enum": ["monthly", "annual"]
        },
        "subscriptionStatus": {
          "type": "string",
          "description": "Current status of the user's subscription",
          "enum": ["active", "trialing", "cancelled"]
        },
        "subscriptionCurrency": {
          "type": "string",
          "description": "Currency used for subscription billing",
          "enum": ["INR", "USD"]
        },
        "subscriptionStartedAt": {
          "type": "string",
          "description": "Subscription start timestamp",
          "maxLength": 64
        },
        "subscriptionExpiresAt": {
          "type": "string",
          "description": "Subscription renewal or expiry timestamp",
          "maxLength": 64
        },
        "lastPaymentId": {
          "type": "string",
          "description": "Most recent verified Razorpay payment ID",
          "maxLength": 100
        },
        "lastOrderId": {
          "type": "string",
          "description": "Most recent verified Razorpay order ID",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "Account registration timestamp",
          "maxLength": 64
        },
        "lastLoginAt": {
          "type": "string",
          "description": "Most recent login timestamp",
          "maxLength": 64
        }
      },
      "required": ["uid", "email"]
    },
    "SubscriptionPayment": {
      "title": "SubscriptionPayment",
      "description": "Verified Razorpay subscription payment receipt owned by a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the user who owns this payment record",
          "maxLength": 128
        },
        "orderId": {
          "type": "string",
          "description": "Razorpay order identifier",
          "maxLength": 100
        },
        "paymentId": {
          "type": "string",
          "description": "Verified Razorpay payment identifier",
          "maxLength": 100
        },
        "planId": {
          "type": "string",
          "description": "Purchased subscription tier",
          "enum": ["free", "pro", "business"]
        },
        "billingCycle": {
          "type": "string",
          "description": "Purchased billing cycle",
          "enum": ["monthly", "annual"]
        },
        "currency": {
          "type": "string",
          "description": "Payment currency",
          "enum": ["INR", "USD"]
        },
        "amount": {
          "type": "number",
          "description": "Paid amount in major currency units"
        },
        "status": {
          "type": "string",
          "description": "Verification status",
          "enum": ["verified"]
        },
        "createdAt": {
          "type": "string",
          "description": "Payment verification timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId", "orderId", "paymentId", "planId", "billingCycle", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Persisted invoice record belonging to an authenticated user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the user who owns this invoice",
          "maxLength": 128
        },
        "invoiceNumber": {
          "type": "string",
          "description": "Unique invoice tracking code such as INV-0042",
          "maxLength": 64
        },
        "clientName": {
          "type": "string",
          "description": "Client or company name being billed",
          "maxLength": 120
        },
        "clientEmail": {
          "type": "string",
          "description": "Client email address for billing and delivery",
          "maxLength": 256
        },
        "clientAddress": {
          "type": "string",
          "description": "Physical billing address of the client",
          "maxLength": 300
        },
        "businessName": {
          "type": "string",
          "description": "Issuing company or freelancer name",
          "maxLength": 120
        },
        "businessEmail": {
          "type": "string",
          "description": "Issuing company billing email",
          "maxLength": 256
        },
        "currency": {
          "type": "string",
          "description": "Currency symbol or ISO code",
          "maxLength": 16
        },
        "issueDate": {
          "type": "string",
          "description": "ISO date of invoice issuance",
          "maxLength": 32
        },
        "dueDate": {
          "type": "string",
          "description": "ISO payment due date",
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "description": "Lifecycle status of the invoice",
          "enum": ["Draft", "Sent", "Paid", "Overdue"]
        },
        "taxRate": {
          "type": "number",
          "description": "Tax percentage applied to items"
        },
        "discountAmount": {
          "type": "number",
          "description": "Monetary discount applied to subtotal"
        },
        "notes": {
          "type": "string",
          "description": "Payment instructions and thank you remarks",
          "maxLength": 2000
        },
        "themeColor": {
          "type": "string",
          "description": "Hex color code for invoice branding",
          "maxLength": 32
        },
        "templateStyle": {
          "type": "string",
          "description": "Selected layout template style",
          "maxLength": 32
        },
        "hideWatermark": {
          "type": "boolean",
          "description": "Whether white-label Pro/Business user hid the Invobill footer"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp",
          "maxLength": 64
        }
      },
      "required": ["userId", "invoiceNumber", "clientName", "status"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Public customer testimonial with star rating and feedback message displayed in TestimonialsSection",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the user who submitted the testimonial",
          "maxLength": 128
        },
        "author": {
          "type": "string",
          "description": "Display name of the testimonial author",
          "minLength": 2,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Job title or role of the author",
          "maxLength": 80
        },
        "company": {
          "type": "string",
          "description": "Company, studio, or agency name of the author",
          "maxLength": 80
        },
        "quote": {
          "type": "string",
          "description": "Customer feedback message",
          "minLength": 10,
          "maxLength": 500
        },
        "rating": {
          "type": "integer",
          "description": "Star rating from 1 to 5"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-assigned creation timestamp"
        }
      },
      "required": ["userId", "author", "role", "company", "quote", "rating", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document keyed by user authentication UID"
    },
    "/users/{userId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of invoices owned by the specified user"
    },
    "/users/{userId}/payments/{paymentId}": {
      "schema": "SubscriptionPayment",
      "description": "Verified Razorpay subscription payment receipts owned by the user"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Publicly readable customer testimonials submitted by verified authenticated users"
    }
  }
}

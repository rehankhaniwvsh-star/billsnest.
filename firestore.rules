rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 120))
        && (!('role' in data) || (data.role is string && data.role.size() <= 80))
        && (!('onboardingCompleted' in data) || data.onboardingCompleted is bool)
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('plan' in data) || (data.plan is string && data.plan in ['free', 'pro', 'business']))
        && (!('billingCycle' in data) || (data.billingCycle is string && data.billingCycle in ['monthly', 'annual']))
        && (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus in ['active', 'trialing', 'cancelled']))
        && (!('subscriptionCurrency' in data) || (data.subscriptionCurrency is string && data.subscriptionCurrency in ['INR', 'USD']))
        && (!('lastPaymentId' in data) || (data.lastPaymentId is string && data.lastPaymentId.size() <= 100))
        && (!('lastOrderId' in data) || (data.lastOrderId is string && data.lastOrderId.size() <= 100));
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['userId', 'invoiceNumber', 'clientName', 'status'])
        && data.userId is string && data.userId == request.auth.uid
        && data.invoiceNumber is string && data.invoiceNumber.size() <= 64
        && data.clientName is string && data.clientName.size() <= 120
        && data.status is string && data.status in ['Draft', 'Sent', 'Paid', 'Overdue'];
    }

    function isValidSubscriptionPayment(data) {
      return data.keys().hasAll(['userId', 'orderId', 'paymentId', 'planId', 'billingCycle', 'status'])
        && data.userId is string && data.userId == request.auth.uid
        && data.orderId is string && data.orderId.size() > 0 && data.orderId.size() <= 100
        && data.paymentId is string && data.paymentId.size() > 0 && data.paymentId.size() <= 100
        && data.planId is string && data.planId in ['free', 'pro', 'business']
        && data.billingCycle is string && data.billingCycle in ['monthly', 'annual']
        && (!('currency' in data) || (data.currency is string && data.currency in ['INR', 'USD']))
        && data.status is string && data.status == 'verified';
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['userId', 'author', 'role', 'company', 'quote', 'rating', 'createdAt'])
        && data.keys().hasOnly(['userId', 'author', 'role', 'company', 'quote', 'rating', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.author is string && data.author.size() >= 2 && data.author.size() <= 80
        && data.role is string && data.role.size() <= 80
        && data.company is string && data.company.size() <= 80
        && data.quote is string && data.quote.size() >= 10 && data.quote.size() <= 500
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.createdAt is timestamp;
    }

    // Public Testimonials Collection (zero PII; verified users can submit and manage their own)
    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId);
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow create: if isVerifiedUser()
        && isValidId(testimonialId)
        && isValidTestimonial(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(testimonialId)
        && resource.data.userId == request.auth.uid
        && isValidTestimonial(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['author', 'role', 'company', 'quote', 'rating']);
      allow delete: if isVerifiedUser()
        && isValidId(testimonialId)
        && resource.data.userId == request.auth.uid;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // PII Protection: do not allow unbounded listing of user accounts
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Invoices subcollection owned by the user
      match /invoices/{invoiceId} {
        allow get: if isValidId(userId) && isOwner(userId) && isValidId(invoiceId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && isValidId(invoiceId)
          && isValidInvoice(request.resource.data);
        allow update: if isValidId(userId) && isOwner(userId) && isValidId(invoiceId)
          && isValidInvoice(request.resource.data)
          && request.resource.data.userId == resource.data.userId;
        allow delete: if isValidId(userId) && isOwner(userId) && isValidId(invoiceId);
      }

      // Subscription payment receipts subcollection owned by the user
      match /payments/{paymentId} {
        allow get: if isValidId(userId) && isOwner(userId) && isValidId(paymentId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && isValidId(paymentId)
          && isValidSubscriptionPayment(request.resource.data);
        allow update: if false; // Payment receipts are immutable
        allow delete: if false; // Payment receipts cannot be tampered with
      }
    }
  }
}
